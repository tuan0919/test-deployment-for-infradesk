# Host paths — runtime data survives image upgrades and container recreate.
DEPLOY_DIR=/var/lib/test-deployment-for-infradesk

REGISTRY=gmo021.cansportsvg.com:9443
IMAGE_NAME=infradesk/test-deployment
IMAGE_TAG=v2.0.0
PUBLISH_PORT=18080

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Backup / restore scripts
BACKUP_ROOT=/var/lib/test-deployment-for-infradesk/backups
